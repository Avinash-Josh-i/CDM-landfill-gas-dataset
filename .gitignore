# ---------------------------------------------------------------------------
# Asia Landfill Project — public release .gitignore
# Track: release/v1.0/, data/processed/ master tables, scripts, tests, docs.
# Ignore: raw source documents, interim extraction data, local caches.
# ---------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
.eggs/

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Jupyter
.ipynb_checkpoints/
*.nbconvert.ipynb

# Environment and credentials
.env
*.env
.cdsapirc
credentials.json

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.out
*.tmp
*.bak
*.cache

# ---------------------------------------------------------------------------
# Local-only data
# ---------------------------------------------------------------------------
# Raw source documents (CDM PDFs, API JSON, workbooks, national sources)
data/raw/

# Interim extraction, audit, validation cache and provenance tables
data/interim/

# Legacy publication export (superseded by release/v1.0/)
data/repository/

# Local cleanup record and old repository-wide manifest (superseded by release manifest)
CLEANUP_DELETED_FILES.txt
data_manifest.csv

# Large local archives
*.zip
*.7z
*.tar
*.tar.gz
